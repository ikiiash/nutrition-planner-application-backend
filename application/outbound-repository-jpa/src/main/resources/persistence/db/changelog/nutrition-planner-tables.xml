<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="nutrition-planner-tables-1.0" author="codex">
        <createTable tableName="food_product">
            <column name="food_product_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="calories" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="protein" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="carbohydrates" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="nutrition-planner-tables-1.1" author="codex">
        <createTable tableName="user_profile">
            <column name="user_profile_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="keycloak_user_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)"/>
            <column name="age" type="INTEGER"/>
            <column name="height_cm" type="DOUBLE PRECISION"/>
            <column name="weight_kg" type="DOUBLE PRECISION"/>
            <column name="goal" type="VARCHAR(64)"/>
            <column name="target_calories" type="DOUBLE PRECISION"/>
            <column name="target_protein" type="DOUBLE PRECISION"/>
            <column name="target_fat" type="DOUBLE PRECISION"/>
            <column name="target_carbohydrates" type="DOUBLE PRECISION"/>
        </createTable>
    </changeSet>

    <changeSet id="nutrition-planner-tables-1.3" author="codex">
        <addColumn tableName="user_profile">
            <column name="nickname" type="VARCHAR(100)"/>
            <column name="first_name" type="VARCHAR(100)"/>
            <column name="gender" type="VARCHAR(16)"/>
            <column name="activity_level" type="VARCHAR(32)"/>
            <column name="bmr" type="DOUBLE PRECISION"/>
            <column name="tdee" type="DOUBLE PRECISION"/>
        </addColumn>
    </changeSet>

    <changeSet id="nutrition-planner-tables-1.2" author="codex">
        <addColumn tableName="food_product">
            <column name="owner_user_id" type="VARCHAR(255)" defaultValue="legacy-user">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(255)" defaultValue="Uncategorized">
                <constraints nullable="false"/>
            </column>
            <column name="grams" type="DOUBLE PRECISION" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>
            <column name="photo_url" type="VARCHAR(1024)"/>
        </addColumn>
        <createIndex tableName="food_product" indexName="idx_food_product_owner_user_id">
            <column name="owner_user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="nutrition-planner-tables-2.0" author="codex">
        <createTable tableName="meal">
            <column name="meal_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="servings" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="meal" indexName="idx_meal_owner_user_id">
            <column name="owner_user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="nutrition-planner-tables-2.1" author="codex">
        <createTable tableName="meal_ingredient">
            <column name="meal_ingredient_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meal_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_meal_ingredient_meal"
                             references="meal(meal_id)"/>
            </column>
            <column name="food_product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="food_product_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="grams" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="calories_per_gram" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="protein_per_gram" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="fat_per_gram" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="carbohydrates_per_gram" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="price_per_gram" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


    <changeSet id="nutrition-planner-tables-3.0" author="codex">
        <createTable tableName="meal_plan">
            <column name="meal_plan_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_user_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="number_of_days" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="meal_plan" indexName="idx_meal_plan_owner_user_id">
            <column name="owner_user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="nutrition-planner-tables-3.1" author="codex">
        <createTable tableName="plan_day">
            <column name="plan_day_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="meal_plan_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_plan_day_meal_plan"
                             references="meal_plan(meal_plan_id)"/>
            </column>
            <column name="day_number" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="nutrition-planner-tables-3.2" author="codex">
        <createTable tableName="plan_entry">
            <column name="plan_entry_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="plan_day_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_plan_entry_plan_day"
                             references="plan_day(plan_day_id)"/>
            </column>
            <column name="meal_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="entry_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="meal_id" type="BIGINT"/>
            <column name="meal_name" type="VARCHAR(255)"/>
            <column name="portions" type="DOUBLE PRECISION"/>
            <column name="food_product_id" type="BIGINT"/>
            <column name="food_product_name" type="VARCHAR(255)"/>
            <column name="grams" type="DOUBLE PRECISION"/>
            <column name="calories" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="protein" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="carbohydrates" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DOUBLE PRECISION">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="nutrition-planner-tables-1.4" author="codex">
        <addColumn tableName="food_product">
            <column name="sodium_mg" type="DOUBLE PRECISION"/>
            <column name="potassium_mg" type="DOUBLE PRECISION"/>
            <column name="magnesium_mg" type="DOUBLE PRECISION"/>
            <column name="iron_mg" type="DOUBLE PRECISION"/>
            <column name="calcium_mg" type="DOUBLE PRECISION"/>
            <column name="zinc_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_a_mcg" type="DOUBLE PRECISION"/>
            <column name="vitamin_c_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_d_mcg" type="DOUBLE PRECISION"/>
            <column name="vitamin_e_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_k_mcg" type="DOUBLE PRECISION"/>
            <column name="vitamin_b1_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_b2_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_b6_mg" type="DOUBLE PRECISION"/>
            <column name="vitamin_b9_mcg" type="DOUBLE PRECISION"/>
            <column name="vitamin_b12_mcg" type="DOUBLE PRECISION"/>
        </addColumn>
    </changeSet>

    <changeSet id="nutrition-planner-tables-2.2" author="codex">
        <addColumn tableName="meal_ingredient">
            <column name="sodium_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="potassium_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="magnesium_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="iron_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="calcium_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="zinc_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_a_mcg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_c_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_d_mcg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_e_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_k_mcg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_b1_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_b2_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_b6_mg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_b9_mcg_per_gram" type="DOUBLE PRECISION"/>
            <column name="vitamin_b12_mcg_per_gram" type="DOUBLE PRECISION"/>
        </addColumn>
